{
  "name": "whistle.replay",
  "version": "1.0.4",
  "description": "whistle 插件：按规则保存抓包响应，并按路径与 HTTP 方法自动回放最新的一条",
  "keywords": [
    "whistle",
    "whistle-plugin",
    "mock",
    "proxy",
    "capture",
    "sse",
    "http"
  ],
  "homepage": "https://github.com/hyunicode/whistle.sake#readme",
  "bugs": {
    "url": "https://github.com/hyunicode/whistle.sake/issues"
  },
  "license": "MIT",
  "author": "Unicode <81250265+hyunicode@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyunicode/whistle.sake.git"
  },
  "main": "./lib",
  "files": [
    "lib",
    "public",
    "rules.txt"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "build": "bun run build:server && bun run build:ui",
    "build:server": "tsc -p tsconfig.server.json",
    "build:ui": "rsbuild build",
    "check": "prettier --check .",
    "dev": "rsbuild",
    "format": "prettier --write .",
    "lint": "eslint . && stylelint \"**/*.css\"",
    "prepare": "bunx husky",
    "preview": "rsbuild preview",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependencies": {
    "@koa/bodyparser": "^6.1.0",
    "@koa/router": "^15.7.0",
    "koa": "^3.2.1",
    "koa-onerror": "^4.1.0",
    "koa-static": "^5.0.0"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.1.0",
    "@codemirror/lang-json": "^6.0.2",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.39.1",
    "@rsbuild/core": "^2.1.11",
    "@rsbuild/plugin-react": "^2.1.0",
    "@types/bun": "^1.3.9",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/koa": "^3.0.0",
    "@types/koa-static": "^4.0.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@uiw/react-codemirror": "^4.25.11",
    "antd": "^6.5.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stylelint": "^17.14.1",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
